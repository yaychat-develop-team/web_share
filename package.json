{
  "name": "web_share",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "pnpm run build:test",
    "build:test": "vue-tsc --build && vite build --mode test",
    "build:prod": "vue-tsc --build && vite build --mode production",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "preview:pages": "pnpm run build:test && npx wrangler pages dev dist",
    "preview:pages:prod": "pnpm run build:prod && npx wrangler pages dev dist"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@fontsource/poppins": "^5.2.7",
    "axios": "^1.15.0",
    "pinia": "^3.0.4",
    "react": "^19.2.6",
    "swiper": "^12.1.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  }
}
